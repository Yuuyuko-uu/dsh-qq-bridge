{
  "name": "dsh-qq-link",
  "version": "1.4.6",
  "description": "通到 QQ：DSH 里的 AI 伙伴和 QQ 双向互通 —— 它说完话自动发到 QQ，你在 QQ 里说的话自动转进 DSH。走 OneBot 11 HTTP（SnowLuma / NapCat 都行）。",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "author": "Yuuyuko-uu (https://github.com/Yuuyuko-uu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuuyuko-uu/dsh-qq-link.git"
  },
  "homepage": "https://github.com/Yuuyuko-uu/dsh-qq-link#readme",
  "bugs": {
    "url": "https://github.com/Yuuyuko-uu/dsh-qq-link/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin"
  ]
}
